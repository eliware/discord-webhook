{
    "name": "@eliware/discord-webhook",
    "type": "module",
    "version": "1.1.8",
    "description": "A simple, promise-based Discord webhook sender for Node.js with built-in rate limit handling.",
    "engines": {
        "node": ">=26"
    },
    "types": "index.d.ts",
    "files": [
        "index.mjs",
        "index.d.ts",
        "README.md",
        "LICENSE",
        "RELEASE_NOTES.md",
        "examples"
    ],
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": {
            "import": "./index.mjs",
            "types": "./index.d.ts"
        }
    },
    "scripts": {
        "test": "eliware-test",
        "lint": "eliware-test --lint",
        "typecheck": "tsc --project tsconfig.json",
        "audit": "npm audit --omit=dev --audit-level=moderate",
        "pack": "npm pack --dry-run"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/eliware/discord-webhook.git"
    },
    "keywords": [
        "discord",
        "webhook",
        "discord-webhook",
        "nodejs",
        "rate-limit",
        "esm",
        "typescript",
        "promise",
        "fetch"
    ],
    "author": "Eli Sterling, eliware.org <eli@eliware.org>",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/eliware/discord-webhook/issues"
    },
    "homepage": "https://github.com/eliware/discord-webhook#readme",
    "devDependencies": {
        "@eliware/test": "^2.0.0",
        "typescript": "^7.0.2"
    }
}
